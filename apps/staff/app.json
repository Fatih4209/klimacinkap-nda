{
  "expo": {
    "name": "Klimacın Kapıda Personel",
    "slug": "klimacin-kapida-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "klimacinkapida-staff",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E4A56"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klimacinkapida.staff",
      "buildNumber": "1",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yalnızca atanmış işte yolda/sahadayken canlı takip için konum kullanılır. İş bitince paylaşım kesilir.",
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      },
      "associatedDomains": [
        "applinks:klimacinkapida.com",
        "applinks:www.klimacinkapida.com"
      ]
    },
    "android": {
      "package": "com.klimacinkapida.staff",
      "versionCode": 1,
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#0E4A56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "https",
              "host": "klimacinkapida.com",
              "pathPrefix": "/open/personel"
            },
            {
              "scheme": "https",
              "host": "klimacinkapida.com",
              "pathPrefix": "/gizlilik"
            },
            {
              "scheme": "https",
              "host": "klimacinkapida.com",
              "pathPrefix": "/hesap-silme"
            },
            {
              "scheme": "https",
              "host": "www.klimacinkapida.com",
              "pathPrefix": "/open/personel"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yalnızca atanmış işte yolda/sahadayken canlı takip için konum kullanılır. İş bitince paylaşım kesilir."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "REPLACE_AFTER_EAS_INIT"
      },
      "privacyPolicyPath": "/gizlilik",
      "accountDeletionPath": "/hesap-silme",
      "storePrivacyPolicyUrl": "https://klimacinkapida.com/gizlilik",
      "storeAccountDeletionUrl": "https://klimacinkapida.com/hesap-silme"
    },
    "owner": "REPLACE_AFTER_EAS_INIT"
  }
}
