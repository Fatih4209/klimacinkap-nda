{
  "expo": {
    "name": "Klimacın Kapıda Personel",
    "slug": "klimacin-kapida-staff",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "klimacinkapida-staff",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.klimacinkapida.staff",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Yalnızca atanmış işte yolda/sahadayken canlı takip için konum kullanılır. İş bitince paylaşım kesilir."
      }
    },
    "android": {
      "package": "com.klimacinkapida.staff",
      "permissions": ["ACCESS_COARSE_LOCATION", "ACCESS_FINE_LOCATION"],
      "adaptiveIcon": {
        "backgroundColor": "#0E4A56",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yalnızca atanmış işte yolda/sahadayken canlı takip için konum kullanılır."
        }
      ]
    ]
  }
}
