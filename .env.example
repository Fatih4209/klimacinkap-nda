# Klimacın Kapıda — environment template (no secrets)
# Copy to .env.local / app-specific env files. Leave blank until provisioned.

# Supabase (project URL + publishable/anon key only in clients)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never ship to clients / never paste into chat)
SUPABASE_SERVICE_ROLE_KEY=

# Optional later integrations (phase e–g)
# NEXT_PUBLIC_MAPS_API_KEY=
# SMS_PROVIDER_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Push (phase f) — without these, push is wired but NOT marked delivered
# EXPO_ACCESS_TOKEN=          # server/edge only; never ship to clients
# EXPO_PUBLIC_PUSH_TOKEN=     # device token from Expo Notifications after native build
