# Klimacın Kapıda — environment template (no secrets)
# Copy to .env.local / app-specific env files. Leave blank until provisioned.

# Supabase (project URL + publishable/anon key only in clients)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (never ship to clients / never paste into chat)
SUPABASE_SERVICE_ROLE_KEY=

# First platform-admin bootstrap (admin-web /api/admin/bootstrap) — min 16 chars
# Refuses if any platform_admin already exists. No public admin signup.
# ADMIN_BOOTSTRAP_SECRET=

# Optional later integrations (phase e–g)
# NEXT_PUBLIC_MAPS_API_KEY=
# SMS_PROVIDER_API_KEY=
# PAYMENT_WEBHOOK_SECRET=

# Push (phase f) — without these, push is wired but NOT marked delivered
# EXPO_ACCESS_TOKEN=          # server/edge only; never ship to clients
# EXPO_PUBLIC_PUSH_TOKEN=     # device token from Expo Notifications after native build

# Billing (phase g) — no cards in our DB; without keys checkout is blocked_no_provider
# STRIPE_SECRET_KEY=          # server only
# PAYMENT_WEBHOOK_SECRET=     # server/edge only; webhook signature

# Release / EAS (phase h) — fill after `eas init`; do not publish publicly from this repo task
# EAS_PROJECT_ID_CUSTOMER=
# EAS_PROJECT_ID_STAFF=
# APPLE_ASC_APP_ID_CUSTOMER=
# APPLE_ASC_APP_ID_STAFF=
